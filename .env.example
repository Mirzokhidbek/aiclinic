# Telegram
# demo tenant bot, from @BotFather
TELEGRAM_BOT_TOKEN=
# random string, checked on every webhook
TELEGRAM_WEBHOOK_SECRET=
# https URL of the API (needed for webhooks)
PUBLIC_BASE_URL=
# https URL of the Mini App
MINIAPP_URL=

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# Data
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://s3:8333
S3_BUCKET=documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Security
JWT_SECRET=
# Fernet key for bot tokens and phone numbers
ENCRYPTION_KEY=

# Observability
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
